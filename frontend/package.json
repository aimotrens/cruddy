  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "daisyui": "5.7.47",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vue-tsc": "3.3.11"
  }
